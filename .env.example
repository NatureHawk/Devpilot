# =============================================================================
# DevPilot — local development configuration
# Copy to .env and adjust. Never commit a populated .env.
# =============================================================================

# ---- Database -------------------------------------------------------------
# Driver is psycopg 3. Keep the "+psycopg" suffix or SQLAlchemy will look for
# psycopg2, which is not installed.
# Use 127.0.0.1, not "localhost": Windows can resolve "localhost" to ::1
# ahead of 127.0.0.1, which silently connects to a different server if one is
# listening on each. If port 5432 is already taken locally, change it (and
# POSTGRES_PORT) to something free, e.g. 5433.
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@127.0.0.1:5432/devpilot

# Credentials used by docker-compose to provision the Postgres container.
# These must stay in sync with DATABASE_URL above.
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot
POSTGRES_DB=devpilot
POSTGRES_PORT=5432

# ---- Backend --------------------------------------------------------------
# "local" enables /docs and verbose tracebacks. Use "production" when deployed.
DEVPILOT_ENV=local
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Origins allowed to call the API from a browser. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend -------------------------------------------------------------
# Used by Next.js server components to reach the API (server-to-server).
BACKEND_URL=http://localhost:8000
# Public origin of the Next.js app itself; used for absolute links/callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Security -------------------------------------------------------------
# Signs session cookies and OAuth state, and derives the key that encrypts
# stored GitHub tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required outside local development; rotating it invalidates sessions and makes
# stored GitHub tokens undecryptable (users simply reconnect).
SECRET_KEY=

# ---- GitHub integration ---------------------------------------------------
# From a GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# Set the app's Authorization callback URL to:
#   http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Reserved for push/PR webhooks; unused in this milestone.
GITHUB_WEBHOOK_SECRET=

# Override to point the client at a stand-in during testing.
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20
# Concurrent blob downloads during indexing. Deliberately modest.
GITHUB_MAX_CONCURRENCY=8

# ---- Indexing limits ------------------------------------------------------
# A file larger than this is recorded as skipped rather than downloaded (512 KiB).
INDEX_MAX_FILE_BYTES=512000
# Ceiling on one repository's indexed source (50 MB).
INDEX_MAX_TOTAL_BYTES=50000000
INDEX_MAX_FILES=5000
# Chunks longer than this are split; large enough to hold most functions.
INDEX_MAX_CHUNK_CHARS=8000
# Line window for files with no parseable structure.
INDEX_FALLBACK_CHUNK_LINES=120

# ---- Embeddings ---------------------------------------------------------
# Semantic retrieval needs an embedding provider. Two hosted ones sit behind
# one interface; nothing above the provider layer knows which is active.
# Without a key for the selected provider, indexing and search report a
# configuration error instead of failing with a provider exception.
#
#   "voyage"  — Voyage AI voyage-code-3. Trained on source code.
#   "gemini"  — Google Gemini API gemini-embedding-001. A generous free tier
#               makes it the better default for routine development.
#
# Switching this requires re-indexing every repository: vectors from different
# models are not comparable, and the per-row provider/model metadata makes
# mixing them impossible rather than merely unlikely.
EMBEDDING_PROVIDER=gemini

# The stored pgvector column width. BOTH providers are asked to emit exactly
# this many dimensions, so it stays consistent across provider, model, database
# column, ANN index, retrieval query and validation. pgvector's HNSW index is
# capped at 2000 dimensions. Changing this is an Alembic migration (the column
# type) plus a re-index — never a config-only change.
#   voyage-code-3       supports 256 / 512 / 1024 / 2048
#   gemini-embedding-001 is a Matryoshka model: any width 128-3072 is a real
#                        embedding at that size (not a truncation). Google
#                        recommends 768 / 1536 / 3072; 1024 is supported and is
#                        what fits the shipped vector(1024) schema untouched.
EMBEDDING_DIMENSIONS=1024
# Wall-clock ceiling on retrying one batch against a rate limit, shared by both
# providers. A free-tier window can be ~a minute; this needs real headroom, but
# it is still a ceiling — indexing fails loudly rather than retrying forever.
EMBEDDING_MAX_RETRY_SECONDS=120

# ---- Voyage AI --------------------------------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-3
EMBEDDING_BATCH_SIZE=64

# ---- Google Gemini embeddings ---------------------------------------
# From Google AI Studio (aistudio.google.com/apikey). A Google AI Pro
# subscription and Gemini API quota are separate things: this uses the Gemini
# API free tier. Do not enable paid billing to run DevPilot in development.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# `batchEmbedContents` inputs per request. Conservative; no documented hard cap.
GEMINI_EMBEDDING_BATCH_SIZE=100

# ---- Retrieval ------------------------------------------------------------
SEARCH_DEFAULT_TOP_K=8
SEARCH_MAX_TOP_K=50

# ---- Language model -------------------------------------------------------
# Powers grounded answers and change investigation. Without a key for the
# selected provider, the Ask and Changes screens report a configuration state
# instead of failing obscurely.
#
#   "groq"       — Groq's OpenAI-compatible API, openai/gpt-oss-120b. Fast free
#                  tier with tool calling, JSON-Schema structured output and
#                  reasoning controls; Gemini embeddings + pgvector unchanged.
#   "gemini"     — Google Gemini API. The primary free development stack:
#                  Gemini generation + Gemini embeddings + pgvector. Streaming,
#                  function calling and native structured output, no ongoing
#                  cost within Google's free-tier quota.
#   "openrouter" — one OpenAI-compatible API in front of many models, some free.
#   "anthropic"  — pay-per-token, claude-opus-5.
# All four implement the same LLMProvider interface; nothing above the provider
# layer knows or cares which is active. Switching requires no other change.
LLM_PROVIDER=groq
LLM_MAX_OUTPUT_TOKENS=8000
# Thinking depth: low | medium | high | xhigh | max. Used by the Anthropic and
# OpenRouter providers; Gemini manages its own (dynamic) thinking budget. Groq
# maps this to reasoning_effort conservatively (default high -> "medium";
# xhigh / max -> "high") since free-tier reasoning tokens count against a small
# TPM budget.
LLM_EFFORT=high

# --- Gemini generation (distinct from the Gemini *embedding* config above) ---
# GEMINI_LLM_API_KEY falls back to GEMINI_API_KEY when blank — one Google API
# key normally covers both surfaces. Model verified against Google's live
# catalogue: gemini-2.5-flash is retired for new keys and Google's own 404
# points here. gemini-3.6-flash is stable (non-preview), has a 1,048,576-token
# context, and supports streaming + function calling + responseSchema. Free-tier
# quota and availability are subject to Google's current limits — not unlimited.
GEMINI_LLM_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
# Small on purpose: the free tier should be backed off from, not hammered, and a
# call must fail loudly rather than retry forever.
GEMINI_LLM_MAX_RETRY_SECONDS=30

# --- Groq ---
# Used only when LLM_PROVIDER=groq. From https://console.groq.com/keys (free).
# openai/gpt-oss-120b verified against Groq's live docs 2026-09-01: 131,072-token
# context, tool use, strict JSON-Schema structured output, and reasoning_effort
# controls. DevPilot sends reasoning_format=hidden and never receives reasoning
# tokens. Structured Outputs cannot be combined with tools or streaming in one
# request — the provider raises a typed capability error, never a bare 400.
# Free-tier limits (RPM / RPD / TPM / TPD) are set by Groq and CAN CHANGE; they
# are reported in x-ratelimit-* response headers, not guaranteed here. Not
# "unlimited": the free tier's TPM is small relative to a full RAG context, so
# heavy repositories may need CONTEXT_MAX_CHARS lowered or a paid Groq tier.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MAX_RETRY_SECONDS=30

# --- Anthropic ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- OpenRouter ---
# Used only when LLM_PROVIDER=openrouter. The default model is free and was
# verified 2026-08-28 two ways: its catalogue entry supports tool calling,
# streaming and a 1M-token context, and a real request — completion,
# streaming, and an actual tool call — was run against it and returned
# correctly. Free models rotate and shared-pool ones can be temporarily
# overloaded (a 429 in that case, not a configuration problem); if this one
# stops working, pick a replacement from https://openrouter.ai/models?max_price=0
# that lists "tools" under supported parameters — the provider refuses to
# start a tool-calling request against one that doesn't, rather than failing
# obscurely mid-investigation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# ---- Context and investigation limits -------------------------------------
CONTEXT_MAX_CHARS=60000
CONVERSATION_HISTORY_TURNS=6
# Hard ceiling on tool calls in one change request.
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_STEPS=10
